# Copy this to wrangler.toml locally and fill in real values.
# wrangler.toml is gitignored - never commit real secrets or database IDs.
name = "zvakho-universal-store-api"
main = "src/index.js"
compatibility_date = "2024-01-01"

[[d1_databases]]
binding = "DB"
database_name = "zvakho-orders-dev"
database_id = "YOUR_D1_DATABASE_ID"

[vars]
ENVIRONMENT = "development"
PAYNOW_INTEGRATION_ID = "YOUR_PAYNOW_INTEGRATION_ID"
BASE_URL = "https://zvakho-payments-v2.yasibomedia.workers.dev"

# Do NOT put JWT_SECRET or PAYNOW_INTEGRATION_KEY in [vars].
# Set them as encrypted secrets instead:
#   wrangler secret put JWT_SECRET
#   wrangler secret put PAYNOW_INTEGRATION_KEY
# Or via Cloudflare dashboard: Worker -> Settings -> Variables -> "Encrypt" toggle
